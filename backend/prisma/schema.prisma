generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum PatientStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum FilterType {
  WASHABLE
  DISPOSABLE
  UNKNOWN
}

enum ReportPlatform {
  AIRVIEW
  CARE_ORCHESTRATOR
  SMART_LIVE
  MANUAL
}

enum ReportStatus {
  AWAITING_MATCH
  PROCESSING
  REVIEW_REQUIRED
  APPROVED
  SENT
  FAILED
}

enum ReportMatchStatus {
  MATCHED
  REVIEW_REQUIRED
  UNMATCHED
  MANUAL
}

enum DocumentType {
  POLYSOMNOGRAPHY
  OTHER
}

enum TemplateCategory {
  FILTER_WASH
  FILTER_REPLACE_DISPOSABLE
  FILTER_REPLACE_WASHABLE
  ANNUAL_MAINTENANCE
  MONTHLY_REPORT
  CUSTOM
}

enum MessageStatus {
  SCHEDULED
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum MessageChannel {
  WHATSAPP
}

enum AutomationJobType {
  MESSAGE_SEND
  REPORT_IMPORT
  REPORT_PROCESS
  REPORT_SEND
  PORTAL_SYNC
}

enum AutomationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  name              String            @db.VarChar(120)
  email             String            @unique @db.VarChar(320)
  username          String?           @unique @db.VarChar(60)
  passwordHash      String            @db.VarChar(255)
  role              UserRole          @default(STAFF)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sessions          AuthSession[]
  patientsCreated   Patient[]         @relation("PatientCreatedBy")
  documentsUploaded PatientDocument[] @relation("DocumentUploader")
  reportsUploaded   PatientReport[]   @relation("ReportUploader")
  auditEvents       AuditLog[]        @relation("AuditActor")
  settingsUpdated   SystemSetting[]   @relation("SettingUpdater")

  @@index([isActive, role])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Patient {
  id               String            @id @default(uuid()) @db.Uuid
  fullName         String            @db.VarChar(180)
  phone            String            @db.VarChar(32)
  birthDate        DateTime?         @db.Date
  therapyStartDate DateTime?         @db.Date
  cpf              String?           @unique @db.VarChar(14)
  cep              String?           @db.VarChar(9)
  email            String?           @db.VarChar(320)
  cpapSerialNumber String?           @db.VarChar(120)
  cpapModelId      String?           @db.Uuid
  cpapModelName    String?           @db.VarChar(160)
  filterType       FilterType?
  physicianName    String?           @db.VarChar(180)
  maskModel        String?           @db.VarChar(160)
  reportPlatform   ReportPlatform?
  status           PatientStatus     @default(ACTIVE)
  whatsappOptIn    Boolean           @default(false)
  whatsappOptOutAt DateTime?
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cpapModel        CpapModel?        @relation(fields: [cpapModelId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents        PatientDocument[]
  reports          PatientReport[]
  messages         MessageLog[]
  jobs             AutomationJob[]
  auditEvents      AuditLog[]

  @@index([fullName])
  @@index([phone])
  @@index([cpapSerialNumber])
  @@index([status, therapyStartDate])
  @@index([cpapModelId, filterType])
  @@index([reportPlatform])
}

model CpapModel {
  id           String     @id @default(uuid()) @db.Uuid
  manufacturer String     @db.VarChar(120)
  model        String     @db.VarChar(160)
  filterType   FilterType @default(UNKNOWN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  patients     Patient[]

  @@unique([manufacturer, model])
  @@index([isActive, filterType])
}

model PatientDocument {
  id           String       @id @default(uuid()) @db.Uuid
  patientId    String       @db.Uuid
  type         DocumentType @default(POLYSOMNOGRAPHY)
  originalName String       @db.VarChar(255)
  storageKey   String       @unique @db.VarChar(255)
  mimeType     String       @db.VarChar(100)
  sizeBytes    Int
  sha256       String       @db.VarChar(64)
  uploadedById String?      @db.Uuid
  createdAt    DateTime     @default(now())
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([sha256])
}

model PatientReport {
  id              String            @id @default(uuid()) @db.Uuid
  patientId       String?           @db.Uuid
  platform        ReportPlatform
  periodStart     DateTime?         @db.Date
  periodEnd       DateTime?         @db.Date
  status          ReportStatus      @default(AWAITING_MATCH)
  matchStatus     ReportMatchStatus @default(UNMATCHED)
  originalName    String            @db.VarChar(255)
  storageKey      String            @unique @db.VarChar(255)
  mimeType        String            @db.VarChar(100)
  sizeBytes       Int
  sha256          String            @unique @db.VarChar(64)
  uploadedById    String?           @db.Uuid
  matchIdentifier String?           @db.VarChar(180)
  extractedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?           @db.Uuid
  failureReason   String?           @db.VarChar(1000)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  patient         Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  uploadedBy      User?             @relation("ReportUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  metrics         ReportMetric[]
  messages        MessageLog[]
  jobs            AutomationJob[]

  @@index([patientId, periodStart, periodEnd])
  @@index([status, createdAt])
  @@index([platform, periodStart])
  @@index([matchStatus])
}

model ReportMetric {
  id          String        @id @default(uuid()) @db.Uuid
  reportId    String        @db.Uuid
  key         String        @db.VarChar(100)
  value       Decimal?      @db.Decimal(14, 4)
  valueText   String?       @db.VarChar(255)
  unit        String?       @db.VarChar(80)
  sourceLabel String?       @db.VarChar(180)
  createdAt   DateTime      @default(now())
  report      PatientReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, key])
  @@index([key])
}

model MessageTemplate {
  id         String           @id @default(uuid()) @db.Uuid
  code       String           @unique @db.VarChar(100)
  name       String           @db.VarChar(180)
  category   TemplateCategory
  filterType FilterType?
  body       String           @db.Text
  mediaUrl   String?          @db.VarChar(2000)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   MessageLog[]

  @@index([category, filterType, isActive])
}

model MessageLog {
  id                String           @id @default(uuid()) @db.Uuid
  patientId         String           @db.Uuid
  reportId          String?          @db.Uuid
  templateId        String?          @db.Uuid
  channel           MessageChannel   @default(WHATSAPP)
  category          TemplateCategory
  status            MessageStatus    @default(SCHEDULED)
  contentSnapshot   String           @db.Text
  scheduledAt       DateTime?
  sentAt            DateTime?
  providerMessageId String?          @db.VarChar(180)
  idempotencyKey    String?          @unique @db.VarChar(180)
  attemptCount      Int              @default(0)
  errorCode         String?          @db.VarChar(120)
  errorMessage      String?          @db.VarChar(1000)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  report            PatientReport?   @relation(fields: [reportId], references: [id], onDelete: SetNull)
  template          MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  jobs              AutomationJob[]

  @@index([patientId, createdAt])
  @@index([status, scheduledAt])
  @@index([category, status])
}

model AutomationJob {
  id           String              @id @default(uuid()) @db.Uuid
  type         AutomationJobType
  status       AutomationJobStatus @default(QUEUED)
  patientId    String?             @db.Uuid
  reportId     String?             @db.Uuid
  messageLogId String?             @db.Uuid
  payload      Json?
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(3)
  scheduledAt  DateTime            @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  errorCode    String?             @db.VarChar(120)
  errorMessage String?             @db.VarChar(1000)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  patient      Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  report       PatientReport?      @relation(fields: [reportId], references: [id], onDelete: SetNull)
  messageLog   MessageLog?         @relation(fields: [messageLogId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([type, createdAt])
  @@index([patientId, createdAt])
}

model SystemSetting {
  id                       String   @id @default("global") @db.VarChar(40)
  timezone                 String   @default("America/Sao_Paulo") @db.VarChar(80)
  sendingWindowStart       String   @default("09:00") @db.VarChar(5)
  sendingWindowEnd         String   @default("18:00") @db.VarChar(5)
  messageAutomationEnabled Boolean  @default(false)
  reportAutomationEnabled  Boolean  @default(false)
  updatedById              String?  @db.Uuid
  updatedAt                DateTime @updatedAt
  updatedBy                User?    @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model PortalSetting {
  id         String         @id @default(uuid()) @db.Uuid
  platform   ReportPlatform @unique
  isEnabled  Boolean        @default(false)
  lastRunAt  DateTime?
  lastStatus String?        @db.VarChar(120)
  updatedAt  DateTime       @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  patientId  String?  @db.Uuid
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(100)
  action     String   @db.VarChar(100)
  fields     String[] @default([])
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
